; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="GunSword"
config/description="You are the Gunman."
config/version="0.0.1a"
run/main_scene="res://mainMenu/scenes/opening/opening.tscn"
config/use_custom_user_dir=true
config/custom_user_dir_name="GunSword"
config/features=PackedStringArray("4.7", "Forward Plus")
boot_splash/bg_color=Color(0, 0, 0, 1)
config/icon="uid://ya8mt3kc3ch1"

[audio]

buses/default_bus_layout="uid://c2qp8l5wslqoh"

[autoload]

AppConfig="*uid://cjke6crjg14a0"
SceneLoader="*uid://cbwmrnp0af35y"
ProjectMusicController="*uid://r5t485lr3p7t"
ProjectUISoundController="*uid://cc37235kj4384"
BackgroundMusic="*uid://e6ifvfy8mj9u"
Console="*uid://ouiu5xh1cs8n"
DialogueManager="*uid://c3rodes2l3gxb"
InputIcons="*res://UI/input_icon_mapper_singleton.gd"
XMBSave="*uid://l0v1uvul8mvx"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/PointMaker/plugin.cfg", "res://addons/console/plugin.cfg", "res://addons/dialogue_manager/plugin.cfg", "res://addons/godot_xmb/plugin.cfg", "res://addons/maaacks_menus_template/plugin.cfg")

